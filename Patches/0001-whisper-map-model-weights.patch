+#ifndef _MSC_VER
+    // A repacked model is mapped rather than read. Anything unexpected here is
+    // not an error - it just falls through to the ordinary read below.
+    {
+        const int fd = open(path_model, O_RDONLY);
+        if (fd >= 0) {
+            uint32_t magic = 0;
+            struct stat st;
+            const bool repacked = fstat(fd, &st) == 0
+                && read(fd, &magic, sizeof(magic)) == (ssize_t) sizeof(magic)
+                && magic == WHISPER_MAP_MAGIC;
+            void * addr = repacked ? mmap(nullptr, st.st_size, PROT_READ, MAP_PRIVATE, fd, 0) : MAP_FAILED;
+            close(fd); // the mapping outlives the descriptor
+            if (addr != MAP_FAILED) {
+                WHISPER_LOG_INFO("%s: mapping %.2f MB of weights\n", __func__, st.st_size / 1e6);
+                if (auto ctx = whisper_init_mapped(addr, st.st_size, params)) {
+                    ctx->path_model = path_model;
+                    return ctx;
+                }
+                WHISPER_LOG_WARN("%s: mapped load failed - falling back to reading\n", __func__);
+                munmap(addr, st.st_size);
+            }
+        }
+    }
+#endif
