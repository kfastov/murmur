+// Reads the mapping the same way whisper_init_from_buffer does, so the file
+// position doubles as the offset of whatever is about to be read — which is
+// what lets the load loop point tensors at the mapping instead of copying.
+struct whisper_map_context {
+    uint8_t * buffer;
+    size_t    size;
+    size_t    current_offset;
+};
+
+static struct whisper_context * whisper_init_no_state_impl(
+        struct whisper_model_loader * loader, struct whisper_context_params params,
+        void * map_addr, size_t map_size, const size_t * map_pos);
+
+static struct whisper_context * whisper_init_mapped(void * addr, size_t size, struct whisper_context_params params) {
+    whisper_map_context mc = { (uint8_t *) addr, size, 0 };
+
+    whisper_model_loader loader = {};
+    loader.context = &mc;
+    loader.read = [](void * ctx, void * output, size_t read_size) {
+        whisper_map_context * m = (whisper_map_context *) ctx;
+        const size_t n = m->current_offset + read_size < m->size ? read_size : m->size - m->current_offset;
+        memcpy(output, m->buffer + m->current_offset, n);
+        m->current_offset += n;
+        return n;
+    };
+    loader.eof   = [](void * ctx) { auto m = (whisper_map_context *) ctx; return m->current_offset >= m->size; };
+    loader.close = [](void *) { };
+
+    return whisper_init_no_state_impl(&loader, params, addr, size, &mc.current_offset);
+}
